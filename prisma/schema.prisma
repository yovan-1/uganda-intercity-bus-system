generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
}

enum TripStatus {
  SCHEDULED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum BookingStatus {
  CONFIRMED
  PENDING
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
  VISA_CARD
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String
  password     String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookings     Booking[]  @relation("UserBookings")
  verifiedTickets Ticket[] @relation("StaffVerifiedTickets")
}

model Vehicle {
  id           String        @id @default(uuid())
  regNumber    String        @unique
  model        String
  totalSeats   Int           @default(36)
  operatorName String
  driverName   String
  status       VehicleStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  seats        Seat[]
  trips        Trip[]
}

model Seat {
  id           String      @id @default(uuid())
  vehicleId    String
  seatNumber   String      // e.g. "1A", "1B", "1C", "1D"
  seatRow      Int
  seatCol      Int
  isAccessible Boolean     @default(false)
  vehicle      Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  passengers   Passenger[]

  @@unique([vehicleId, seatNumber])
}

model Route {
  id                String   @id @default(uuid())
  origin            String
  destination       String
  distanceKm        Int
  estimatedDuration String   // e.g. "4h 30m"
  basePriceUGX      Int
  createdAt         DateTime @default(now())
  trips             Trip[]
}

model Trip {
  id             String     @id @default(uuid())
  routeId        String
  vehicleId      String
  departureTime  DateTime
  arrivalTime    DateTime
  priceUGX       Int
  availableSeats Int
  status         TripStatus @default(SCHEDULED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model Booking {
  id             String        @id @default(uuid())
  bookingRef     String        @unique // e.g. UG-8942-XJ
  userId         String
  tripId         String
  totalAmountUGX Int
  paymentStatus  PaymentStatus @default(PENDING)
  bookingStatus  BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user       User        @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)
  trip       Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passengers Passenger[]
  payment    Payment?
  ticket     Ticket?
}

model Passenger {
  id        String  @id @default(uuid())
  bookingId String
  seatId    String
  fullName  String
  phone     String
  email     String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String        @id @default(uuid())
  bookingId      String        @unique
  transactionRef String        @unique
  amountUGX      Int
  method         PaymentMethod
  status         PaymentStatus @default(PAID)
  paidAt         DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Ticket {
  id                String    @id @default(uuid())
  bookingId         String    @unique
  ticketCode        String    @unique
  qrData            String
  issuedAt          DateTime  @default(now())
  verifiedAt        DateTime?
  verifiedByStaffId String?

  booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  verifiedByStaff User?   @relation("StaffVerifiedTickets", fields: [verifiedByStaffId], references: [id], onDelete: SetNull)
}
