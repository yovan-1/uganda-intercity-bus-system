{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "includeFiles": "prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/schedules",
      "destination": "/public/schedules.html"
    },
    {
      "source": "/search",
      "destination": "/public/search.html"
    },
    {
      "source": "/seats",
      "destination": "/public/seats.html"
    },
    {
      "source": "/checkout",
      "destination": "/public/checkout.html"
    },
    {
      "source": "/confirmation",
      "destination": "/public/confirmation.html"
    },
    {
      "source": "/auth",
      "destination": "/public/auth.html"
    },
    {
      "source": "/dashboard",
      "destination": "/public/dashboard.html"
    },
    {
      "source": "/staff",
      "destination": "/public/staff.html"
    },
    {
      "source": "/admin",
      "destination": "/public/admin.html"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
